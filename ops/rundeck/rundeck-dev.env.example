# Populate securely on the server. Never commit tokens, passwords or SAP logs.
# systemd LoadCredential is the preferred reader credential path. RUNDECK_TOKEN_FILE
# remains only as a compatibility fallback during rollout.
RUNDECK_TOKEN_FILE=/etc/sphere/rundeck-readonly.token
RUNDECK_PROJECT=Linux
RUNDECK_JOB_GROUP=SAP/AOP
RUNDECK_JOB_NAME=[Critical]-[Daily Check] SPHERE SAP Work Proccess Check
RUNDECK_EXPECTED_HOSTS=AOPH1PAPPDC,AOPH2PAPPDC,AOPH3PAPPDC,AOPH4PAPPDC,AOPH5PAPPDC

# /dev historical database. TimescaleDB is optional; PostgreSQL is the fallback.
# IMPORTANT: use a separate database from production.
DB_MODE=hybrid
DATABASE_URL=postgresql+psycopg://sphere@/sphere_rundeck_dev?host=/var/run/postgresql
SPHERE_RETENTION_DAYS=90
SPHERE_DISK_WARNING_PCT=70
SPHERE_DISK_CRITICAL_PCT=85
SPHERE_INODE_WARNING_PCT=75
SPHERE_INODE_CRITICAL_PCT=90
SPHERE_MAINTENANCE_INTERVAL_SECONDS=21600
SPHERE_PLATFORM_HEALTH_CACHE_SECONDS=30
SPHERE_RELEASES_KEEP=5
SPHERE_RUN_DEV_MIGRATIONS=false

# Optional backup job writes a small status JSON here. The API never reads backup data itself.
SPHERE_BACKUP_STATUS_FILE=/var/lib/sphere/ingestion/backup.json

# Health thresholds; tune only after observing the dev baseline.
SPHERE_CPU_WARNING_PCT=75
SPHERE_CPU_CRITICAL_PCT=90
SPHERE_RAM_WARNING_PCT=80
SPHERE_RAM_CRITICAL_PCT=90
SPHERE_IOWAIT_WARNING_PCT=10
SPHERE_IOWAIT_CRITICAL_PCT=20
SPHERE_WP_WARNING=1
SPHERE_WP_CRITICAL=3
RUNDECK_STALE_MINUTES=20

# Current performance incident correlation. A healthy sample or a gap larger
# than INCIDENT_GAP closes the previous continuous incident window.
SPHERE_INCIDENT_LOOKBACK_HOURS=24
SPHERE_INCIDENT_GAP_MINUTES=22

# Program / background-job evaluation. These are deterministic review thresholds,
# not automatic root-cause declarations. Current 1D/7D/30D windows are compared
# with the immediately preceding equivalent period.
SPHERE_EVAL_CPU_HIGH_AVG_PCT=70
SPHERE_EVAL_CPU_HIGH_PEAK_PCT=100
SPHERE_EVAL_PSS_HIGH_GB=4
SPHERE_EVAL_INCREASE_PCT=25
SPHERE_EVAL_RECURRING_PCT=30
SPHERE_EVAL_WP_CORRELATION_PCT=30

# Collect Now: separate Rundeck identity sphere_runner.
# Keep disabled until user authentication is in front of the mutating route.
# When /etc/sphere/rundeck-runner.token exists, deploy-dev.sh loads it through a
# systemd credential drop-in. RUNDECK_RUNNER_TOKEN_FILE remains a compatibility fallback.
RUNDECK_COLLECT_NOW_ENABLED=false
RUNDECK_RUNNER_TOKEN_FILE=/etc/sphere/rundeck-runner.token
RUNDECK_RUN_JOB_ID=REPLACE_WITH_EXACT_SPHERE_JOB_UUID
RUNDECK_COLLECT_COOLDOWN_SECONDS=300
