[Unit]
Description=CBJ Monitoring API
After=network.target

[Service]
Type=simple
User=sadmin
Group=sadmin
WorkingDirectory=/home/sadmin/ops
Environment=HOST=127.0.0.1
Environment=PORT=8790
Environment=MONITORING_DOMAIN=cbj-kontruksi.com
ExecStart=/usr/bin/node /home/sadmin/ops/cbj-monitoring-server.mjs
Restart=always
RestartSec=3
StandardOutput=append:/var/log/cbj-monitoring.log
StandardError=append:/var/log/cbj-monitoring.log
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
